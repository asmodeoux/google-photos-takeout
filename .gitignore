# Takeout input, the built library, and extracts. Never commit these.
archives/*
!archives/.gitkeep
results/*
!results/.gitkeep
results-sample/*
!results-sample/.gitkeep
unzipped/*
!unzipped/.gitkeep

# Media, even if it lands outside those folders.
*.zip
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.heic
*.heif
*.mov
*.mp4
*.m4v
*.mkv
*.avi

# Synthetic test media generated by scripts/gen-fixtures.sh.
!internal/testgen/testdata/
!internal/testgen/testdata/**

.DS_Store
/takeout
/takeout.exe
*.partial
*_original
*_exiftool_tmp
results/.takeout/
